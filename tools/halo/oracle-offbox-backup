#!/usr/bin/env python3
"""Copy HALO's backups off the box to Cloudflare R2: never this box, never siso-vps.

Shaan, 11 Oct 2026 (A0 17:01): "we don't use the SISO VPS anymore ... we should be just paying for the Halo". Until
then this rsynced everything to siso-vps (a write-only rrsync target; STREAMING's job 12 on 26 Sep, the estate's from
27 Sep), and its 06:15 run on 11 Oct failed (rsync 255: siso-vps no longer answers). It now writes to the bucket and
key HALO already holds, /home/shaan/.config/halo/r2.env (halo-media; object read, write and list on that bucket only):
  backups/convex/<file>.age                  every Convex backup zip and its .sha256 (oracle-convex-backup)
  backups/donor-databases/<run>/<file>.age   Cam's donor dumps (Twenty, AFFiNE, Plane, Buzz; halo-donor-backup)
  backups/databases/<run>/<file>.age         the databases with SHA256SUMS and manifest.json (halo-estate-dump)
  backups/planes/<plane>/<run>/<file>        the planes; their blobs are already encrypted (halo-plane-pack)
Every file not already age-encrypted is encrypted to HALO's public key first (/etc/halo-backup/age-recipient.txt, the
one halo-plane-pack uses). The identity is off the box: the estate credentials store, SISO_Agency/partners/halo/age.
A key already in the bucket is never written again; each put carries its SHA-256, so R2 refuses bytes changed on the
way, and the run fails unless every new key lists afterwards. Unlike the siso-vps target, this key can delete, and
nothing prunes yet (about 40 MB a night).
Restore: fetch a run (presigned links made on this box, or the Cloudflare dashboard), `age -d -i halo-backup.key`
each file, `sha256sum -c SHA256SUMS`, pg_restore.
Source: siso-estate tools/halo/oracle-offbox-backup -> /usr/local/sbin/oracle-offbox-backup on halo-vps.
"""
import base64, collections, hashlib, os, subprocess, sys, tempfile

import boto3
from botocore.config import Config

ENV, RECIPIENT, ROOT = "/home/shaan/.config/halo/r2.env", "/etc/halo-backup/age-recipient.txt", "backups/"
SOURCES = [  # folder, key prefix, what the rsync excluded beside .tmp-* (a folder by path, a file by name)
    ("/srv/oracle/backups/convex", "convex/", ()),
    ("/home/shaan/halo/backups/donor-databases", "donor-databases/", ()),
    ("/srv/halo-outbox", "databases/", ("/srv/halo-outbox/planes",)),
    ("/srv/halo-outbox/planes", "planes/", ("LAST",)),  # absent until halo-plane-pack first writes
]


def files(top, prefix, skip):
    """(path, key) for each file under top, as rsync -a with those excludes saw it."""
    for d, dirs, names in os.walk(top):
        dirs[:] = sorted(x for x in dirs if not x.startswith(".tmp-") and os.path.join(d, x) not in skip)
        for name in sorted(names):
            if not name.startswith(".tmp-") and name not in skip:
                path = os.path.join(d, name)
                yield path, ROOT + prefix + os.path.relpath(path, top) + ("" if name.endswith(".age") else ".age")


def sha256(path):
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for block in iter(lambda: f.read(1 << 20), b""):
            h.update(block)
    return base64.b64encode(h.digest()).decode()


def listed(s3, bucket):
    pages = s3.get_paginator("list_objects_v2").paginate(Bucket=bucket, Prefix=ROOT)
    return {o["Key"] for page in pages for o in page.get("Contents", [])}


def main():
    env = {}
    for line in open(ENV):
        k, eq, v = line.strip().removeprefix("export ").partition("=")
        if eq and not k.startswith("#"):
            env[k] = v.strip("'\"")
    endpoint = env["R2_ENDPOINT"].rstrip("/")
    if not endpoint.endswith(".r2.cloudflarestorage.com"):  # A0 17:01: R2, never this box, never siso-vps
        sys.exit("oracle-offbox-backup: R2_ENDPOINT is not Cloudflare R2; nothing sent")
    for top, _, _ in SOURCES[:3]:
        if not os.path.isdir(top):
            sys.exit(f"oracle-offbox-backup: {top} is missing; nothing sent")
    s3 = boto3.client("s3", endpoint_url=endpoint, region_name="auto", aws_access_key_id=env["R2_ACCESS_KEY_ID"],
                      aws_secret_access_key=env["R2_SECRET_ACCESS_KEY"], config=Config(retries={"max_attempts": 5}))
    bucket = env["R2_BUCKET"]
    there = listed(s3, bucket)
    new = [(p, k) for top, prefix, skip in SOURCES for p, k in files(top, prefix, skip) if k not in there]
    groups = dict(collections.Counter(k.split("/")[1] for _, k in new))
    if "--dry-run" in sys.argv:
        print(f"offbox dry run: R2 {bucket}/{ROOT}: {len(new)} new {groups}, {len(there)} already there")
        return
    sent = 0
    with tempfile.TemporaryDirectory() as tmp:
        for path, key in new:
            blob = path if path.endswith(".age") else os.path.join(tmp, "blob.age")
            if blob != path:
                subprocess.run(["age", "-R", RECIPIENT, "-o", blob, path], check=True)
            with open(blob, "rb") as f:
                s3.put_object(Bucket=bucket, Key=key, Body=f, ChecksumSHA256=sha256(blob))
            sent += os.path.getsize(blob)
    missing = {k for _, k in new} - listed(s3, bucket)
    if missing:
        sys.exit(f"oracle-offbox-backup: {len(missing)} of {len(new)} new keys do not list in R2")
    print(f"offbox backup ok: R2 {bucket}/{ROOT}: {len(new)} new {groups} ({sent} bytes), {len(there)} already there")


if __name__ == "__main__":
    main()
