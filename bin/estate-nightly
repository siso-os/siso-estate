#!/usr/bin/env bash
# Nightly estate run on any machine on the map (laptop: launchd com.siso.estate-nightly; Linux: root's crontab).
# Re-inventory, back up disk-only work to private GitHub (secret-scanned), rebuild the ONE estate map
# (sisodias/siso-city) from every machine's records and push it, count the city (census.json); Sundays the laptop also runs the encrypted data planes.
set -uo pipefail
export PATH="/opt/homebrew/bin:/usr/local/bin:$HOME/.local/bin:/usr/bin:/bin:$PATH"
M=${ESTATE_MACHINE:-laptop}
WS=$HOME/SISO_Workspace
E=$(cd "$(dirname "$0")/.." && pwd)
MONOREPO=0; [ -f "$E/module.json" ] && [ "$(basename "$(dirname "$E")")" = estate ] && MONOREPO=1
cd "$E" || exit 1
# A live-tree update can replace directories while a long inventory is running.
# Resolve the landed source directory anew for each Python stage.
estate_python() { (cd "$E" && python3 "$@"); }
RECORD_DIR=$(python3 -c 'from tools.estate_state import record_path; import sys; print(record_path(sys.argv[1], "machines", sys.argv[2], "nightly.log"))' "$E" "$M")
RECORD_DIR=${RECORD_DIR%/nightly.log}
mkdir -p "$RECORD_DIR"
# pull before the log opens: nightly.log is tracked, so a pull that rewrites it sent the rest of the night's output
# into the replaced (deleted) file; from 28 Sep to 1 Oct the log held only "nightly start" lines.
# catchup, not `pull --autostash`: a stash takes other agents' work, and from 16 to 19 Oct the pull failed every night,
# so the records were committed here and never pushed (main 16 ahead, 94 behind)
PULL=""
if [ "$MONOREPO" = 0 ]; then
PULL=$(estate_python tools/catchup.py --run 2>&1) || PULL="$PULL
estate pull failed (tools/catchup.py held: see above)"
fi
exec >> "$RECORD_DIR/nightly.log" 2>&1
echo "=== $(date '+%F %T') nightly start ($M)"
[ -n "$PULL" ] && echo "$PULL"
BACKUP_STATUS=0
critical() {
  "$@"
  local result=$?
  if [ "$result" -ne 0 ]; then
    echo "FAIL ($result): $*"
    BACKUP_STATUS=1
  fi
  return "$result"
}
# The hourly inventory discovers roots; nightly refreshes each known checkout's
# actual Git state. Do not re-walk multi-terabyte data payloads before backing up.
if critical estate_python tools/inventory.py --known --git-timeout 5 --no-sizes --machine "$M" ${ESTATE_ROOTS:+--roots $ESTATE_ROOTS}; then
  if critical estate_python tools/backup.py plan --machine "$M"; then
    # Inventory can contain detached build trees. Keep unknown sources in the
    # existing encrypted data plane instead of creating a GitHub product per tree.
    critical estate_python tools/backup.py run --machine "$M" --jobs 4
  fi
fi
# a checkout held by the secret scan is backed up age-encrypted (held_copy); one with no good copy is loud: console card
# + A0 inbox line every night until fixed (A0, 3 Oct: Oracle core's work sat only on the laptop, seen by nobody)
critical estate_python tools/backup.py alert --machine "$M" || echo "backup: a held repo is NOT backed up (estate_python tools/backup.py alert)"
# fast-forward only: other agents' uncommitted memory edits sit in the map's tree, and a rebase pull refuses to run over them
(cd "$WS" && git fetch -q origin && git merge -q --ff-only origin/main) || echo "map pull: not a fast-forward (the snapshot below rebases on push)"
estate_python tools/dots.py --machine "$M" || echo "dots failed"
estate_python tools/doors.py --commit || echo "doors failed"
estate_python tools/laptop-map.py --machine "$M" || echo "laptop map failed"
estate_python tools/umbrella.py build --machine "$M"
estate_python tools/umbrella.py snapshot --push --machine "$M"
estate_python tools/umbrella.py verify --machine "$M" || echo "map: a pinned commit is not on GitHub (machines/$M/map-verify.json)"   # A16
estate_python tools/census.py --machine "$M" || echo "census failed"
estate_python tools/code.py --machine "$M" && estate_python tools/fix.py --run --machine "$M" || echo "building code or fixes failed"
estate_python tools/code.py --machine "$M" >/dev/null || echo "building code rescore failed"
estate_python tools/births.py --machine "$M" || echo "births failed"
estate_python tools/guard.py --machine "$M" || echo "births guard failed"   # report-only: repos born in 30 days without `estate new` (P1)
# the register and every list generated from it (ADR 0018): a generator nothing runs is a stale document waiting to happen
estate_python tools/projects.py --machine "$M" >/dev/null || echo "projects failed"
if [ "$M" = laptop ]; then
  estate_python tools/register.py >/dev/null || echo "register failed"
  estate_python tools/render.py >/dev/null || echo "render failed"
  estate_python tools/docs_check.py --machine "$M" >/dev/null || echo "docs check failed"
  estate_python tools/door_top.py --check --machine "$M" >/dev/null || echo "door tops out of date (estate_python tools/door_top.py --run)"
  estate_python tools/services.py check || echo "launchd drift (estate services)"
  estate_python tools/services.py ports >/dev/null || echo "port collision (estate_python tools/services.py ports; P5)"
  estate_python tools/links.py --repair || echo "links scan failed"   # heals links a recorded move broke (fix policy link-repair); reports live / Oracle-HALO / vendor / gitignored broken links (A3)
  estate_python tools/score.py --machine "$M" >/dev/null || echo "score failed"
fi
if [ "$M" = laptop ] && [ "$(date +%u)" = 7 ]; then estate_python tools/data-backup.py run all; fi
# what runs on every server, read over ssh (client boxes are recorded, never mapped): machines/<m>/servers.json
if [ "$M" = laptop ]; then estate_python tools/servers.py scan || echo "servers: a box did not answer"; fi
# a server's own data planes (plan/data-planes.json "machine"), every night (siso-vps ran these until it was retired, 19 Oct)
if [ "$M" != laptop ]; then critical estate_python tools/data-backup.py run all --machine "$M" || echo "data planes: error"; fi
# never commit a merge conflict: on 28 Sep an autostash pop left markers in plan/data-planes.json, this commit took
# them, and every tool that reads the planes failed until 1 Oct
if [ "$MONOREPO" = 1 ]; then
  echo "records kept outside Git: $RECORD_DIR; code follows landed monorepo main"
else
CONFLICT=$( { git diff --name-only --diff-filter=U; grep -l -E '^(<<<<<<<|>>>>>>>) ' plan/*.json; } 2>/dev/null | sort -u | tr '\n' ' ')
if [ -n "$CONFLICT" ]; then
  echo "records NOT committed: merge conflict in $CONFLICT"
  [ -x "$HOME/.claude/console/bin/console-post" ] && "$HOME/.claude/console/bin/console-post" -a ESTATE -k card \
    -t "estate nightly: merge conflict ($M)" "The nightly did not commit: $CONFLICT has merge conflict markers. Resolve them in SISO_Agents/siso-estate, then commit." >/dev/null
else
git add machines plan && git commit -qm "estate: nightly records $M $(date +%F)" \
  && gitleaks git . --log-opts=-1 --redact --no-banner >/dev/null 2>&1 \
  && { git push -q || { estate_python tools/catchup.py --run && git push -q; }; } || echo "records not pushed (nothing new, the secret scan flagged the commit, or catchup held)"
[ "$(git rev-list --count origin/main..HEAD 2>/dev/null)" = 0 ] || echo "WARN: main has $(git rev-list --count origin/main..HEAD) commits GitHub lacks"
fi
fi
echo "=== $(date '+%F %T') nightly end"
python3 - "$RECORD_DIR/nightly-status.json" "$M" "$BACKUP_STATUS" <<'PY'
import datetime, json, pathlib, sys
pathlib.Path(sys.argv[1]).write_text(json.dumps({"machine":sys.argv[2], "completed_at":datetime.datetime.now(datetime.timezone.utc).isoformat(), "backup_exit":int(sys.argv[3])}, indent=2)+"\n")
PY
exit "$BACKUP_STATUS"
