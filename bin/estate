#!/usr/bin/env python3
"""estate: find anything on this machine, check the layout, back it up.

  estate where <words...>     best homes for a thing (path, what it is, its GitHub repo)
  estate path <words...>      just the best path (for scripts): cd "$(estate path oracle)"
  estate map                  the city map: every district and what lives there
  estate doctor               layout checks (exit 1 on a failure)
  estate inventory            re-scan every git repo on this machine
  estate backup plan|run      back up disk-only work to private GitHub (see tools/backup.py)
  estate move SRC DST --why   move a folder to its planned home, leaving a compat link
  estate data plan|run PLANE  backup of data outside repos (encrypted, or plain private) (plan/data-planes.json)
  estate umbrella build|snapshot [--push]   the machine umbrella repo (~/SISO_Workspace)
  estate restore [--run]      rebuild every repo from the umbrella's restore map
  estate census               count the city: repos on/off the map, disk-only work, duplicate homes, homeless files
  estate brief [--mark]       the Estate Manager's boot packet: what changed since the last session (--mark ends one)
  estate report "<what, where>"   any agent: file a mess you found outside your task into the Estate Manager's inbox
  estate doors [--check]      regenerate the district front doors' folder tables (tools/doors.py, plan/doors.json)
  estate refresh [--light]    regenerate every map from the disk: doors, the laptop map, hidden folders, the umbrella
  estate dots                 the hidden folders in the workspace, against ADR 0015 (tools/dots.py)
  estate code [words]         the building code: every live repo scored (tools/code.py); with words, one repo's certificate
  estate fix [--run]          apply the written fix policies to repos below the building code (tools/fix.py, plan/fix-policies.json)
  estate births               where agents create repos, clones and worktrees, and whether they ask the map (tools/births.py)
  estate city                 the operations centre, live at http://127.0.0.1:8895/ (tools/city.py; launchd com.siso.estate-city)
  estate register [--check]   the register: every building's island, compound, postcode, provenance, keeper, sites, and the
                              doctor's findings (tools/register.py -> machines/register.json; ADR 0018, docs/MODEL.md)
  estate docs [--check]       every path cited in every door, checked against the disk and the move records (tools/docs_check.py)
  estate packet <building>    the landing packet for one building: card, door, now, memory, tasks, letters, rules (tools/packet.py)
  estate new <island>/[<district>/]<compound>[/<building>] [--kind K] [--what "..."] [--run] [--github]
  estate run <project> [-- CMD]   start it on its registered port, recorded with who started it (tools/run.py, P5);
                                   `estate stop <project>`, `estate running`
  estate services [check|adopt|install]   every com.siso launchd job from one manifest (plan/services.json, tools/services.py)
  estate fleet [--json] [--all]   every machine exec-probed now: free cores, RAM, disk, what runs there, what it is for
                              (tools/fleet.py, plan/machines.json); `estate fleet pick <job-kind> [--n N]` names the box,
                              `estate fleet pull <machine> <job>` brings results to _data/fleet/<machine>/<job>/
  estate wait <tool> [--timeout S]   block until no process runs tools/<tool> (backup, vault, census, ...); the safe
                              way to wait: a shell `until ! pgrep -f` loop matches its own command line and never ends
  estate render               the island render: the whole estate as a three.js voxel territory, from the register
                              (tools/render.py -> plan/render/index.html)
                              the one road to a new building: placed, named, carded and titled (tools/new.py; dry run by default)

Data: machines/<machine>/repos.json (generated by `estate inventory`), plan/aliases.json (hand:
names people use for things), the Great Library overlay (Works -> paths). Nothing else.
"""
import glob, json, os, re, socket, subprocess, sys, time

BIN = os.path.dirname(os.path.realpath(__file__))
REPO = os.path.dirname(BIN)
HOME = os.path.expanduser("~")
WS = os.path.join(HOME, "SISO_Workspace")


def machine():
    m = os.environ.get("ESTATE_MACHINE")
    if m:
        return m
    host = socket.gethostname().lower()
    return "mini" if "mini" in host else "vps" if "vps" in host or "contabo" in host else "laptop"


def load_json(p, default):
    try:
        return json.load(open(p))
    except Exception:
        return default


def first_line(path):
    for name in ("AGENTS.md", "README.md"):
        p = os.path.join(path, name)
        if os.path.isfile(p):
            try:
                for line in open(p, errors="replace"):
                    line = line.strip().lstrip("#").strip()
                    if line and not line.startswith(("<", "---", "@")):
                        return line[:110]
            except Exception:
                pass
    return ""


def candidates():
    m = machine()
    inv = load_json(os.path.join(REPO, "machines", m, "repos.json"), {"repos": []})
    aliases = load_json(os.path.join(REPO, "plan", "aliases.json"), {}).get("aliases", {})
    out = {}
    for r in inv["repos"]:
        p = r["path"]
        if "/.t/" in p or "/node_modules/" in p or "/SISO_Workspace/_archive/" in p:
            continue                                   # the vault holds retired copies; a place is never one of them
        gh = (r.get("github") or [{}])[0]
        out[p] = {"path": p, "kind": r["kind"], "github": f"{gh.get('owner')}/{gh.get('repo')}" if gh else "",
                  "words": set()}
    for name, target in aliases.items():
        p = os.path.join(WS, target) if not target.startswith(("/", "~")) else os.path.expanduser(target)
        out.setdefault(p, {"path": p, "kind": "alias", "github": "", "words": set()})
        out[p]["words"].update(re.findall(r"[a-z0-9]+", name.lower()))
        out[p]["alias"] = name
    overlay = load_json(os.path.join(WS, "Great_Library_of_SISO", ".local", "private-registry", "overlay.json"), {})
    for e in overlay.get("entries", []):
        p = e.get("path", "")
        if p:
            out.setdefault(p, {"path": p, "kind": e.get("unit_kind", ""), "github": "", "words": set()})
            out[p]["words"].update(re.findall(r"[a-z0-9]+", e.get("entry_id", "").lower()))
    # the map: a repo kept on GitHub only (an empty folder here, or none) is a place too, and says how to bring it back
    for rel, e in load_json(os.path.join(WS, ".estate", "map.json"), {}).get("repos", {}).items():
        p = os.path.join(WS, rel)
        if rel.startswith(("_archive/", "_data/")) or p in out or os.path.exists(os.path.join(p, ".git")):
            continue
        gh = re.search(r"github\.com[:/]([^/]+/[^/]+?)(?:\.git)?$", e.get("url", ""))
        out[p] = {"path": p, "kind": f"on GitHub only on this machine: estate restore --only {rel} --run", "github_only": True,
                  "github": gh.group(1) if gh else "", "words": set(re.findall(r"[a-z0-9]+", (e.get("why") or "").lower()))}
    # client folders are places too, though the repos are inside them: SISO's clients and each partner's clients
    for cdir in glob.glob(os.path.join(WS, "SISO_Agency", "clients", "*")) + glob.glob(os.path.join(WS, "SISO_Agency", "partners", "*", "clients", "*")):
        if os.path.isdir(cdir) and not os.path.islink(cdir) and cdir not in out:
            partner = cdir.split("/partners/")[1].split("/")[0] if "/partners/" in cdir else "siso"
            out[cdir] = {"path": cdir, "kind": f"client of {partner}", "github": "",
                         "words": set(re.findall(r"[a-z0-9]+", os.path.basename(cdir).lower())) | {"client", partner}}
    live = []
    for c in out.values():
        if not os.path.exists(c["path"]) and not c.get("github_only"):
            continue  # a stale alias or overlay entry must never be offered as a place
        c["words"] |= set(re.findall(r"[a-z0-9]+", one_line(c["path"]).lower()))
        live.append(c)
    return live


def one_line(path):
    """The repo's `**In one line:**` header (AGENTS.md), used as searchable words."""
    p = os.path.join(path, "AGENTS.md")
    try:
        with open(p, errors="replace") as f:
            for i, line in enumerate(f):
                if line.startswith("**In one line:**"):
                    return line[16:].split("District:")[0]
                if i > 12:
                    break
    except OSError:
        pass
    return ""


# question words an agent types around the thing it wants ("where is the ... kept?"); they are not the thing
STOP = set("""a an the is are was be been do does did go goes going where which what who whose how when why should
would could can i we you it its it's s of for to in on at by from with into and or not only just one kept keep live
lives living real new brand get put find my our their this that these those there here stuff thing things folder
place home copy created create made make anything everything each every""".split())


def score(c, q):
    p = os.path.realpath(c["path"]) if os.path.exists(c["path"]) else c["path"]
    hay = (p.lower() + " " + c["github"].lower() + " " + " ".join(c["words"]))
    toks = [t for t in re.findall(r"[a-z0-9]+", q.lower()) if t not in STOP] or re.findall(r"[a-z0-9]+", q.lower())
    if not toks:
        return 0
    s = 0
    base = os.path.basename(p).lower()
    missing = 0
    for t in toks:
        if t in c["words"]:
            s += 6
        if t == base or base.replace("-", "").replace("_", "") == t or base.replace("-", "_") == t:
            s += 8
        elif t in base:
            s += 4
        elif t in hay:
            s += 1
        elif t not in c["words"]:
            missing += 1
    if missing > max(1 if len(toks) >= 3 else 0, len(toks) // 2):  # a question asked in a sentence still finds
        return 0
    s -= missing * 4
    s -= p.count("/") * 0.15          # shallower wins
    if "/_archive/" in p or "/_data/" in p or "/.worktrees/" in p or "/worktrees/" in p:
        s -= 5
    if c["kind"] == "worktree":
        s -= 3
    if "/siso-agent-base/" in p:     # inside the warehouse (the warehouse itself stays findable)
        s -= 4                        # the read-only warehouse; the live copy is elsewhere
    if re.search(r"/(research|docs|references?|examples?|vendor|handoffs|archive)/", p):
        s -= 3                        # a clone kept inside another repo's notes, not a home
    gh_owner = c["github"].split("/")[0].lower() if c["github"] else ""
    if gh_owner and gh_owner not in ("sisodias", "lordsisodia", "none"):
        s -= 1.5                      # third-party code ranks below SISO's own
    if c.get("alias"):
        s += 3
    return s


def where(q, n=6):
    ranked = sorted(((score(c, q), c) for c in candidates()), key=lambda x: -x[0])
    seen, res = set(), []
    for s, c in ranked:
        if s <= 0:
            break
        rp = os.path.realpath(c["path"])
        if rp in seen:
            continue
        seen.add(rp)
        res.append(c)
        if len(res) >= n:
            break
    return res


def register():
    try:
        return json.load(open(os.path.join(REPO, "machines", "register.json")))
    except (OSError, ValueError):
        return {}


def reg_line(b):
    law = {"halo": "  law: Cam's code stays in his repo", "home": "  law: private"}.get(b.get("partner") or b["island"], "")
    law = (f"  partner: {b['partner']}" + (f" (client {b['client']})" if b.get("client") else "") if b.get("partner") else "") + law
    return (f"    {b['compound']} · postcode {b['postcode']} · keeper {b['seat']} · {b['lifecycle']} · {b['provenance']}"
            + (f" · runs on {', '.join(r['site'] for r in b['runs'])}" if b.get("runs") else "") + law)


def cmd_where(args):
    q = " ".join(args).strip()
    reg = {b["path"]: b for b in register().get("buildings", [])}
    exact = [b for b in reg.values() if q and b["postcode"].lower() == q.lower()]
    for b in exact:                    # a postcode resolves in one step (ADR 0018)
        print(f"~/SISO_Workspace/{b['path']}  [postcode {b['postcode']}]\n{reg_line(b)}")
    res = where(q)
    if not res and not exact:
        print("nothing found; try fewer words, or `estate map`")
        return 1
    shown = {os.path.join(WS, b["path"]) for b in exact}
    for c in res:
        p = os.path.realpath(c["path"]) if os.path.exists(c["path"]) else c["path"]
        if p in shown:
            continue
        tp = "~" + p[len(HOME):] if p.startswith(HOME) else p
        extra = f"  [{c['github']}]" if c["github"] and c["github"] != "None/None" else ""
        print(f"{tp}{extra}\n    {c['kind'] if c.get('github_only') else first_line(p) or c['kind']}")
        rel = p[len(WS) + 1:] if p.startswith(WS + "/") else None
        if rel in reg:
            print(reg_line(reg[rel]))
    return 0


def cmd_path(args):
    res = where(" ".join(args), 1)
    if not res:
        return 1
    print(os.path.realpath(res[0]["path"]))
    return 0


def cmd_map(_):
    mp = os.path.join(WS, "AGENTS.md")
    print(open(mp).read())
    return 0


ALLOWED_ROOT = None


def cmd_report(rest):
    """One line into .agents/INBOX.md, read at every Estate Manager boot (no herdr ping: it would type into a working pane)."""
    what = " ".join(rest).strip()
    if not what:
        print('usage: estate report "<what you found, and where>"', file=sys.stderr)
        return 2
    who = os.environ.get("HERDR_AGENT_NAME") or os.path.basename(os.getcwd())
    line = f"- [ ] {time.strftime('%Y-%m-%d')} {who}: {what}"
    with open(os.path.join(REPO, ".agents", "INBOX.md"), "a") as f:
        f.write(line + "\n")
    print(f"filed for the Estate Manager: {line}")
    return 0


def cmd_doctor(_):
    spec = load_json(os.path.join(REPO, "plan", "layout.json"), {})
    allowed = set(spec.get("root_allowed", []))
    fails, warns = [], []
    for name in sorted(os.listdir(WS)):
        p = os.path.join(WS, name)
        if name in allowed:
            continue
        if os.path.islink(p):
            warns.append(f"compat link at the root: {name} -> {os.readlink(p)}")
        elif os.path.isdir(p) and os.listdir(p) and all(os.path.islink(os.path.join(p, x)) or x == ".DS_Store" for x in os.listdir(p)):
            warns.append(f"folder of compat links at the root: {name}/ ({', '.join(x for x in os.listdir(p) if x != '.DS_Store')})")
        else:
            fails.append(f"not in the plan at the root: {name}")
    for name in os.listdir(WS):
        p = os.path.join(WS, name)
        if os.path.islink(p) and not os.path.exists(p):
            fails.append(f"broken link at the root: {name}")
    # rooms inside a building (ADR 0006) and temporary test repos left in one: live, from each repo on this disk
    for r in load_json(os.path.join(REPO, "machines", machine(), "repos.json"), {}).get("repos", []):
        rp = r.get("path", "")
        if not rp.startswith(WS + "/") or "/_archive/" in rp or "/_data/" in rp:
            continue
        rel = os.path.relpath(rp, WS)
        wt = os.path.join(rp, ".worktrees")
        if os.path.isdir(wt) and [x for x in os.listdir(wt) if x != ".DS_Store"]:
            fails.append(f"worktrees inside a repo (ADR 0006: _data/worktrees/<repo>/<lane>): {rel}/.worktrees ({len(os.listdir(wt))})")
        t = os.path.join(rp, ".t")
        if os.path.isdir(t):
            n = sum(1 for x in os.listdir(t) if os.path.exists(os.path.join(t, x, ".git")))
            if n:
                fails.append(f"temporary git repos left in a repo: {rel}/.t ({n}; a test's leftovers, clean them or ignore them)")
    lk = load_json(os.path.join(REPO, "machines", machine(), "links.json"), {})
    live = [x for x in lk.get("broken", []) if x.get("kind", "live") == "live"]
    if live:
        c = lk.get("counts", {})
        warns.append(f"broken symlinks: {len(live)} live (+{c.get('owned', 0)} Oracle/HALO, {c.get('vendor', 0)} in vendor trees, {c.get('ignored', 0)} gitignored; python3 tools/links.py --list; --repair fixes those broken by a recorded move), e.g. {live[0]['path'][:100]}")
    bj = load_json(os.path.join(REPO, "machines", machine(), "backup.json"), {"results": []})
    bad = [r for r in bj["results"] if r.get("status") in ("error", "held", "needs-create")]
    for r in bad:
        warns.append(f"backup {r['status']}: {r['path']}")
    # new mess, from the last census: each of these was cleaned to zero or explained on 24 Sep, so any line is news
    c = load_json(os.path.join(REPO, "machines", machine(), "census.json"), {})
    ok2 = spec.get("second_homes_ok", {})  # a second home kept on purpose, with its reason (plan/layout.json)
    for repo, homes in (c.get("duplicates", {}).get("live_duplicate_homes") or {}).items():
        if repo in ok2:
            continue
        warns.append(f"two live homes for {repo}: {', '.join(p for kind, p in homes if kind == 'live')}")
    loose = c.get("homeless", {}).get("loose_in_repos", {})
    for p in loose.get("too_big_for_backup", {}).get("repos", []):
        warns.append(f"loose pile over the snapshot cap, on this disk only: {p} (give it a data plane or an ignore rule)")
    for p, b in loose.get("big_files_in_no_plane", {}).get("top", []):
        warns.append(f"files over 10 MB in no data plane, on this disk only: {p} ({b // 1048576} MB)")
    for n in c.get("homeless", {}).get("home", {}).get("unplanned_top_level", []):
        warns.append(f"unplanned in ~: {n}")
    r = subprocess.run([sys.executable, os.path.join(REPO, "tools", "doors.py"), "--check"], capture_output=True, text=True)
    for line in r.stdout.splitlines():
        warns.append(f"front door out of date ({line.removeprefix('stale: ')}): run `estate doors`, commit the door")
    r = subprocess.run([sys.executable, os.path.join(REPO, "tools", "door_top.py"), "--check", "--machine", machine()], capture_output=True, text=True)
    miss = next((ln for ln in r.stdout.splitlines() if ln.startswith("missing the block: ")), "")
    if miss:
        n = len(miss.split(": ", 1)[1].split(", "))
        warns.append(f"doors missing the generated top (A8): {n} live repos, e.g. {miss.split(': ', 1)[1].split(', ')[0]} (python3 tools/door_top.py --run [--dirty])")
    for ln in r.stdout.splitlines():
        if ln.startswith("out of date: "):
            warns.append(f"door tops out of date: {ln[13:][:120]} (python3 tools/door_top.py --run)")
    r = subprocess.run([sys.executable, os.path.join(REPO, "tools", "laptop-map.py"), "--check"], capture_output=True, text=True)
    if r.returncode:
        warns.append("the laptop map is out of date: run `estate refresh --light`")
    dots = load_json(os.path.join(REPO, "machines", machine(), "dots.json"), {}).get("findings", {})
    for k in ("tool state tracked in git", "runtime files tracked", "worktrees inside a repo", "key stores outside .credentials"):
        if dots.get(k):
            warns.append(f"hidden folders, {k}: {len(dots[k])} (estate dots; ADR 0015), e.g. {dots[k][0]['path']}")
    code = load_json(os.path.join(REPO, "machines", machine(), "code.json"), {})
    if code:
        warns.append(f"building code: {code.get('up_to_code')} of {code.get('repos')} live repos up to code (estate code; the city page shows which)")
    reg = load_json(os.path.join(REPO, "machines", "register.json"), {}).get("issues", {})
    for key, label in (("I1 one repo on two live plots (second homes)", "second homes"),
                       ("I1 a repo archived on GitHub still has a live plot beside its vault plot", "archived repos with a live plot"),
                       ("I6 rooms inside a building (.worktrees, ADR 0006)", "worktrees inside a building"),
                       ("pebbles: temporary git folders left inside a building (test or tool leftovers)", "temporary git folders"),
                       ("I9 git folders off the map (second copies, nested clones or unplotted work)", "git folders off the map")):
        v = reg.get(key)
        if v and v.get("count"):
            warns.append(f"target (A3): {v['count']} {label}, e.g. {str(v['items'][0])[:110]} (estate register)")
    if machine() == "laptop":
        s = subprocess.run([sys.executable, os.path.join(REPO, "tools", "services.py"), "check"], capture_output=True, text=True)
        for line in s.stdout.splitlines():
            if line.startswith("DRIFT "):
                warns.append(f"launchd {line[6:]} (estate services; plan/services.json, A11)")
        subprocess.run([sys.executable, os.path.join(REPO, "tools", "services.py"), "ports"], capture_output=True, text=True)
        pj = load_json(os.path.join(REPO, "machines", machine(), "ports.json"), {})
        if pj.get("collisions"):
            warns.append(f"port collisions: {pj['collisions']} (python3 tools/services.py ports; P5)")
        if pj.get("unregistered_dev_servers"):
            warns.append(f"dev servers on ports not in plan/ports.json: {len(pj['unregistered_dev_servers'])}, e.g. {pj['unregistered_dev_servers'][:5]} (python3 tools/services.py ports; P5)")
    city = subprocess.run(["curl", "-s", "-o", "/dev/null", "-w", "%{http_code}", "--max-time", "3", "http://127.0.0.1:8895/"], capture_output=True, text=True).stdout
    if machine() == "laptop" and city != "200":
        warns.append("the operations centre is down: launchctl kickstart -k gui/$(id -u)/com.siso.estate-city")
    for f in fails:
        print("FAIL", f)
    for w in warns:
        print("WARN", w)
    print(f"{len(fails)} failures, {len(warns)} warnings")
    return 1 if fails else 0


def passthrough(script, args):
    return subprocess.call([sys.executable, os.path.join(REPO, "tools", script), *args])


def cmd_wait(rest):
    """Block until no process runs tools/<tool>.py. Reads `ps` and skips itself and its parents, so unlike
    `until ! pgrep -f ...` it cannot wait on its own command line."""
    if not rest:
        print("usage: estate wait <tool> [--timeout S]", file=sys.stderr)
        return 2
    tool = rest[0][:-3] if rest[0].endswith(".py") else rest[0]
    limit = float(rest[rest.index("--timeout") + 1]) if "--timeout" in rest else 6 * 3600
    mine, pid = set(), os.getpid()
    while pid > 1:                                     # this process and every ancestor (the shell that called us)
        mine.add(pid)
        out = subprocess.run(["ps", "-o", "ppid=", "-p", str(pid)], capture_output=True, text=True).stdout.strip()
        pid = int(out) if out.isdigit() else 1
    needle = re.compile(r"(^|[\s/])tools/" + re.escape(tool) + r"\.py(\s|$)")
    t0 = time.time()
    while True:
        ps = subprocess.run(["ps", "-axo", "pid=,command="], capture_output=True, text=True).stdout
        busy = [l.strip() for l in ps.splitlines() if l.strip() and int(l.split()[0]) not in mine
                and needle.search(l) and " wait " not in l and "pgrep" not in l]
        if not busy:
            print(f"tools/{tool}.py: none running")
            return 0
        if time.time() - t0 > limit:
            print(f"tools/{tool}.py still running after {limit:.0f}s: {busy[0][:160]}", file=sys.stderr)
            return 1
        time.sleep(5)


def main():
    a = sys.argv[1:]
    if not a or a[0] in ("-h", "--help", "help"):
        print(__doc__)
        return 0
    c, rest = a[0], a[1:]
    if c == "where":
        return cmd_where(rest)
    if c == "path":
        return cmd_path(rest)
    if c == "map":
        return cmd_map(rest)
    if c == "report":
        return cmd_report(rest)
    if c == "wait":
        return cmd_wait(rest)
    if c == "doors":
        return passthrough("doors.py", rest)
    if c == "services":
        return passthrough("services.py", rest or ["check"])
    if c == "fleet":
        return passthrough("fleet.py", rest)
    if c in ("run", "stop", "running"):
        return passthrough("run.py", [{"run": "start"}.get(c, c), *rest])
    if c == "refresh":
        return passthrough("refresh.py", ["--machine", machine(), *rest])
    if c == "dots":
        return passthrough("dots.py", ["--machine", machine(), *rest])
    if c == "code":
        return passthrough("code.py", ["--machine", machine(), *rest])
    if c == "fix":
        return passthrough("fix.py", ["--machine", machine(), *rest])
    if c == "births":
        return passthrough("births.py", ["--machine", machine(), *rest])
    if c == "city":
        rc = passthrough("city.py", ["build"])
        print("live: http://127.0.0.1:8895/  (rebuilt every 2 minutes by launchd com.siso.estate-city)")
        return rc
    if c == "doctor":
        return cmd_doctor(rest)
    if c == "register":
        return passthrough("register.py", rest)
    if c == "docs":
        return passthrough("docs_check.py", ["--machine", machine(), *rest])
    if c == "packet":
        return passthrough("packet.py", rest)
    if c == "new":
        return passthrough("new.py", rest)
    if c == "render":
        return passthrough("render.py", rest)
    if c == "inventory":
        return passthrough("inventory.py", ["--machine", machine(), *rest])
    if c == "backup":
        return passthrough("backup.py", [*rest[:1], "--machine", machine(), *rest[1:]])
    if c == "move":
        return passthrough("move.py", rest)
    if c == "restore":
        return passthrough("restore.py", rest)
    if c == "umbrella":
        return passthrough("umbrella.py", [*rest[:1], "--machine", machine(), *rest[1:]] if rest and rest[0] == "build" else rest)
    if c == "data":
        return passthrough("data-backup.py", [*rest, "--machine", machine()])
    if c == "census":
        return passthrough("census.py", ["--machine", machine(), *rest])
    if c == "brief":
        return passthrough("brief.py", ["--machine", machine(), *rest])
    print(f"unknown command: {c}\n{__doc__}")
    return 2


if __name__ == "__main__":
    sys.exit(main())
