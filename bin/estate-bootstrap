#!/usr/bin/env bash
# Install the estate from SISO's landed monorepo, with mutable records outside Git.
set -eu
M=${1:?usage: estate-bootstrap <machine> [map paths...]}; shift
WS=$HOME/SISO_Workspace
MAIN=$WS/_data/worktrees/siso/main
LIVE=$WS/_data/worktrees/siso/live
command -v gh >/dev/null && gh auth setup-git >/dev/null 2>&1 || true
if [ ! -e "$WS/.git" ]; then
  [ ! -e "$WS" ] || { echo "$WS exists and is not the estate map; held"; exit 1; }
  git clone -q https://github.com/sisodias/siso-city.git "$WS"
fi
if [ ! -e "$MAIN/.git" ]; then
  mkdir -p "$(dirname "$MAIN")"
  git clone -q https://github.com/sisodias/siso.git "$MAIN"
fi
"$MAIN/bin/siso" sync
"$MAIN/bin/siso" live
[ -x "$LIVE/ops/estate/core/bin/estate" ] || { echo 'ops/estate/core must be admitted in .siso/live'; exit 1; }
grep -q "ESTATE_MACHINE=" "$HOME/.profile" 2>/dev/null || echo "export ESTATE_MACHINE=$M" >> "$HOME/.profile"
BIN=$HOME/.local/bin
mkdir -p "$BIN" "$WS/_data/estate/runtime/machines/$M"
for c in estate estate-manager estate-bootstrap; do
  [ ! -L "$BIN/$c" ] || { echo "$BIN/$c is a symlink; held"; exit 1; }
  printf '#!/bin/sh\nexec "%s/estate/core/bin/%s" "$@"\n' "$LIVE" "$c" > "$BIN/$c"
  chmod +x "$BIN/$c"
done
if [ "$#" -gt 0 ]; then
  git -C "$WS" submodule update --init -- "$@"
fi
if [ "$(uname)" = Linux ]; then
  ( crontab -l 2>/dev/null | grep -v estate-nightly || true
    echo "30 3 * * * ESTATE_MACHINE=$M $LIVE/ops/estate/core/bin/estate-nightly" ) | crontab -
fi
echo "estate installed for $M from $LIVE/ops/estate/core; export ESTATE_MACHINE=$M on this machine"
